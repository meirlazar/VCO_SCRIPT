#!/bin/bash
# Written by Meir Lazar
# Version: 5.0 07/18/2026
# Enterprise Version Control for Linux Filesystems
# Refactored for strictly numeric menus, auto-dependency resolution, and colorized diffing.

[[ "$#" -ne 1 ]] && { echo "Usage: $(basename "$0") {filename.ext}"; exit 1; }

TARGET="$1"; FILE=$(basename "$TARGET"); DIR=$(dirname "$TARGET")
VCDIR=".vc"; LOCK="LCK"; TTNS=2

err_handler() {
    logger -t vc "Error on line $1 (Exit code: $2)"
    echo "Script error at line $1 with exit code $2" >&2
}

trap 'err_handler $LINENO $?' ERR


check_deps() {
    [[ -f "$DIR/$FILE" ]] || touch "$DIR/$FILE"
    [[ -w "$DIR/$FILE" ]] || { echo "Error: $FILE must be writeable."; exit 1; }
    [[ -d "$DIR/$VCDIR" ]] || mkdir -p "$DIR/$VCDIR"
    COUNT=$(find "$DIR/$VCDIR" -maxdepth 1 -name "$FILE.*" -type f 2>/dev/null | grep -Ev "\.$LOCK$|\.ORIGINAL$" | wc -l)
    LASTMOD=$(stat -c %y "$DIR/$FILE" 2>/dev/null | cut -d'.' -f1 || echo "NEVER")
}

install_pkg() {
    local bin="$1"; local pkg="$2"
    command -v "$bin" >/dev/null 2>&1 && return 0

    tput setaf 3; echo -e "\nMissing dependency: $bin. Attempting automatic installation of '$pkg'..."
    tput sgr0; sleep 1

    if command -v apt-get >/dev/null 2>&1; then sudo apt-get install -y "$pkg"
    elif command -v dnf >/dev/null 2>&1; then sudo dnf install -y "$pkg"
    elif command -v yum >/dev/null 2>&1; then sudo yum install -y "$pkg"
    else tput setaf 1; echo "Unsupported package manager. Install '$pkg' manually."; sleep $TTNS; return 1; fi
}

draw_ui() {
    clear; tput setaf 3; tput bold; echo "L I N U X - V E R S I O N - C O N T R O L"
    tput sgr0; tput rev; echo " $1 "
    tput sgr0; tput setaf 7
    echo -e "FileName: $FILE\nRevisions: $COUNT\nLatest Change: $LASTMOD\n"
    tput setaf 6
}

get_editor() {
    [[ -f ~/.vcoeditor ]] && EDITOR=$(<~/.vcoeditor) && [[ -x "$EDITOR" ]] && return
    while true; do
        draw_ui "E D I T O R - M E N U"
        echo -e "1. vim\n2. vi\n3. nano\n4. gedit\n5. geany"
        tput bold; tput setaf 1; read -rp "Select editor [1-5]: " choice; tput sgr0
        case $choice in
            1) e_path=$(which vim 2>/dev/null) ;;
            2) e_path=$(which vi 2>/dev/null) ;;
            3) e_path=$(which nano 2>/dev/null) ;;
            4) e_path=$(which gedit 2>/dev/null) ;;
            5) e_path=$(which geany 2>/dev/null) ;;
            *) echo "Invalid."; sleep $TTNS; continue ;;
        esac
        [[ -x "$e_path" ]] && echo "$e_path" > ~/.vcoeditor && EDITOR="$e_path" && break
        echo "Editor not installed or invalid."; sleep $TTNS
    done
}

check_lock() {
    while [[ -f "$DIR/$VCDIR/$FILE.$LOCK" ]]; do
        draw_ui "F I L E  L O C K E D - M E N U"
        tput bold; tput setaf 1; echo "$FILE IS CURRENTLY OPENED OR WAS NOT CLOSED PROPERLY."
        tput sgr0; tput setaf 9
        echo -e "1. Delete LOCK (destroy changes)\n2. Save/Commit LOCKED file\n3. Resume editing\n4. Quit"
        tput bold; read -rp "Choice [1-4]: " lchoice; tput sgr0
        case $lchoice in
            1) rm -f "$DIR/$VCDIR/$FILE.$LOCK" ;;
            2) do_checkin; return ;;
            3) do_checkout; return ;;
            4) exit 0 ;;
            *) echo "Invalid."; sleep $TTNS ;;
        esac
    done
}

do_checkout() {
    [[ -f "$DIR/$VCDIR/$FILE.ORIGINAL" ]] || cp -np "$DIR/$FILE" "$DIR/$VCDIR/$FILE.ORIGINAL"
    cp "$DIR/$FILE" "$DIR/$VCDIR/$FILE.$LOCK"
    draw_ui "C H E C K O U T - M E N U"
    tput bold; tput setaf 1; echo "Properly close/save $FILE before continuing..."
    logger -t vc "Checkout initiated for $DIR/$FILE by $USER"
    sleep $TTNS; "$EDITOR" "$DIR/$VCDIR/$FILE.$LOCK" +1; wait
}

do_checkin() {
    draw_ui "C H E C K  I N - M E N U"
    tput bold; tput setaf 1; echo "Editing complete. Checking in."
    if cmp -s "$DIR/$FILE" "$DIR/$VCDIR/$FILE.$LOCK"; then
        tput setaf 4; echo "No Changes made."; rm -f "$DIR/$VCDIR/$FILE.$LOCK"; sleep $TTNS; return
    fi
    ((COUNT++)); NOW=$(date +"%F_%T")
    tput setaf 4; read -rp "Type comments: " comms

    if grep -q "### VERSION CONTROL ###" "$DIR/$VCDIR/$FILE.$LOCK"; then
        sed -i "/### VERSION CONTROL ###/a ### $NOW REV:$COUNT COMMENTS: $comms ###" "$DIR/$VCDIR/$FILE.$LOCK"
    elif grep -q "^#!" "$DIR/$VCDIR/$FILE.$LOCK"; then
        sed -i "/^#!/a ### VERSION CONTROL ###\n### $NOW REV:$COUNT COMMENTS: $comms ###" "$DIR/$VCDIR/$FILE.$LOCK"
    else
        sed -i "1i ### VERSION CONTROL ###\n### $NOW REV:$COUNT COMMENTS: $comms ###" "$DIR/$VCDIR/$FILE.$LOCK"
    fi

    cp "$DIR/$VCDIR/$FILE.$LOCK" "$DIR/$VCDIR/$FILE.$NOW"
    mv "$DIR/$VCDIR/$FILE.$LOCK" "$DIR/$FILE"
    logger -t vc "Checkin complete for $DIR/$FILE (Rev: $COUNT)"
}

do_revert() {
    draw_ui "R E V E R T - M E N U"
    [[ $COUNT -eq 0 ]] && { tput setaf 1; echo "No older revisions exist."; sleep $TTNS; return; }
    echo -e "Reverting will not remove newer versions.\n"

    mapfile -t files < <(find "$DIR/$VCDIR" -maxdepth 1 -name "$FILE.*" -type f 2>/dev/null | grep -Ev "\.$LOCK$|\.ORIGINAL$" | sort -d)
    for i in "${!files[@]}"; do echo "$((i+1)). $(basename "${files[i]}")"; done
    echo -e "\n$(( ${#files[@]} + 1 )). Return to Main Menu\n$(( ${#files[@]} + 2 )). Quit"

    tput setaf 2; read -rp "Selection: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        if (( choice > 0 && choice <= ${#files[@]} )); then
            local target_file="${files[choice-1]}"
            if cp -f "$target_file" "$DIR/$FILE" 2>/dev/null; then
                echo "SUCCESS: Reverted to $(basename "$target_file")"
                logger -t vc "Reverted $DIR/$FILE to $(basename "$target_file")"
            else
                echo "FAILED: Permission or copy error."
            fi
            sleep $TTNS
        elif (( choice == ${#files[@]} + 1 )); then return
        elif (( choice == ${#files[@]} + 2 )); then exit 0
        else echo "Selection out of bounds."; sleep $TTNS; fi
    else echo "Invalid input. Numbers only."; sleep $TTNS; fi
}

do_move() {
    draw_ui "M O V E - M E N U"
    echo -e "Moves file and all historical versions.\n\n1. Proceed with Move\n2. Return to Main Menu\n3. Quit"
    read -rp "Choice [1-3]: " choice
    case $choice in
        2) return ;; 3) exit 0 ;; 1) ;; *) echo "Invalid."; sleep $TTNS; return ;;
    esac

    read -rp "Type new absolute directory path: " n_dir
    [[ -d "$n_dir" ]] || { echo "$n_dir does not exist."; sleep $TTNS; return; }

    mkdir -p "$n_dir/$VCDIR" || { echo "Failed making $n_dir/$VCDIR"; sleep $TTNS; return; }
    mv "$DIR/$FILE" "$n_dir/" && mv "$DIR/$VCDIR/$FILE."* "$n_dir/$VCDIR/" 2>/dev/null
    logger -t vc "Moved $DIR/$FILE to $n_dir/"
    DIR="$n_dir"
}

do_rename() {
    draw_ui "R E N A M E - M E N U"
    echo -e "Renames file and all historical versions.\n\n1. Proceed with Rename\n2. Return to Main Menu\n3. Quit"
    read -rp "Choice [1-3]: " choice
    case $choice in
        2) return ;; 3) exit 0 ;; 1) ;; *) echo "Invalid."; sleep $TTNS; return ;;
    esac

    read -rp "Type new filename: " n_name
    [[ -z "$n_name" ]] && { echo "Filename cannot be empty."; sleep $TTNS; return; }

    mv "$DIR/$FILE" "$DIR/$n_name" || { echo "Rename failed."; sleep $TTNS; return; }
    for f in "$DIR/$VCDIR/$FILE."*; do [[ -e "$f" ]] && mv "$f" "$DIR/$VCDIR/$n_name.${f##*.}"; done
    logger -t vc "Renamed $DIR/$FILE to $DIR/$n_name"
    FILE="$n_name"
}

do_delete() {
    draw_ui "D E L E T E - M E N U"
    tput setaf 1; echo "WARNING: Deleting will remove the target file and ALL historical versions."
    tput setaf 7; echo -e "\n1. Yes, permanently delete everything\n2. No, return to Main Menu\n3. Quit"
    read -rp "Choice [1-3]: " d_choice
    case $d_choice in
        1) rm -f "$DIR/$FILE" "$DIR/$VCDIR/$FILE."*; logger -t vc "Deleted $DIR/$FILE and all revisions"; exit 0 ;;
        2) return ;; 3) exit 0 ;; *) echo "Invalid choice."; sleep $TTNS ;;
    esac
}

do_previous() {
    draw_ui "A L L   V E R S I O N S - M E N U"
    [[ $COUNT -eq 0 ]] && { tput setaf 1; echo "No revisions exist."; sleep $TTNS; return; }

    mapfile -t files < <(find "$DIR/$VCDIR" -maxdepth 1 -name "$FILE.*" -type f 2>/dev/null | grep -Ev "\.$LOCK$|\.ORIGINAL$" | sort -d)
    for i in "${!files[@]}"; do echo "$((i+1)). $(basename "${files[i]}")"; done
    echo -e "\n$(( ${#files[@]} + 1 )). Return to Main Menu\n$(( ${#files[@]} + 2 )). Quit"

    read -rp "Choice: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        if (( choice == ${#files[@]} + 1 )); then return; fi
        if (( choice == ${##files[@]} + 2 )); then exit 0; fi
    fi
}

do_compare() {
    [[ $COUNT -lt 2 ]] && { echo "Need at least 2 revisions to compare."; sleep $TTNS; return; }
    while [[ -z "$DIFFTOOL" ]]; do
        draw_ui "S E T  D I F F  T O O L - M E N U"
        echo -e "1. vimdiff\n2. diff\n3. wdiff\n4. difff\n5. colordiff\n6. git diff\n7. Menu"
        read -rp "Select [1-7]: " c_choice
        case $c_choice in
            1) DIFFTOOL="vimdiff" ;; 2) DIFFTOOL="diff" ;; 3) DIFFTOOL="wdiff" ;; 4) DIFFTOOL="difff" ;;
            5) install_pkg colordiff colordiff || continue; DIFFTOOL="colordiff" ;;
            6) install_pkg git git || continue; DIFFTOOL="git" ;;
            7) return ;;
            *) echo "Invalid."; sleep $TTNS ;;
        esac
    done

    draw_ui "C O M P A R E - M E N U"
    mapfile -t files < <(find "$DIR/$VCDIR" -maxdepth 1 -name "$FILE.*" -type f 2>/dev/null | grep -Ev "\.$LOCK$|\.ORIGINAL$" | sort -d)
    for i in "${!files[@]}"; do echo "$((i+1)). $(basename "${files[i]}")"; done
    echo ""
    read -rp "Select 1st file number: " idx1; read -rp "Select 2nd file number: " idx2

    if [[ "$idx1" =~ ^[0-9]+$ && "$idx2" =~ ^[0-9]+$ ]] && (( idx1 > 0 && idx1 <= ${#files[@]} && idx2 > 0 && idx2 <= ${#files[@]} )); then
        local f1="${files[idx1-1]}"; local f2="${files[idx2-1]}"
        case "$DIFFTOOL" in
            git) git diff --no-index --color=always "$f1" "$f2" | less -R ;;
            colordiff) colordiff "$f1" "$f2" | less -R ;;
            *) "$DIFFTOOL" "$f1" "$f2" ;;
        esac
        read -rp "Press Enter to return to Main Menu..."
    else echo "Invalid input or out of bounds."; sleep $TTNS; fi
}

do_view() {
    draw_ui "F I L E  V I E W - M E N U"
    [[ $COUNT -eq 0 ]] && { tput setaf 1; echo "No revisions exist."; sleep $TTNS; return; }

    mapfile -t files < <(find "$DIR/$VCDIR" -maxdepth 1 -name "$FILE.*" -type f 2>/dev/null | grep -Ev "\.$LOCK$|\.ORIGINAL$" | sort -d)
    for i in "${!files[@]}"; do echo "$((i+1)). $(basename "${files[i]}")"; done
    echo -e "\n$(( ${#files[@]} + 1 )). Return to Main Menu\n$(( ${#files[@]} + 2 )). Quit"

    tput setaf 6; read -rp "Selection: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        if (( choice > 0 && choice <= ${#files[@]} )); then less "${files[choice-1]}"; wait
        elif (( choice == ${#files[@]} + 1 )); then return
        elif (( choice == ${#files[@]} + 2 )); then exit 0
        else echo "Selection out of bounds."; sleep $TTNS; fi
    else echo "Invalid input."; sleep $TTNS; fi
}

while true; do
    check_deps; check_lock; draw_ui "M A I N - M E N U"
    echo -e "1. CHECKOUT\n2. REVERT\n3. PREVIOUS list\n4. COMPARE\n5. VIEW\n6. Change EDITOR\n7. MOVE\n8. RENAME\n9. DELETE\n10. Quit"
    tput bold; tput setaf 1; read -rp "Choice: " m_choice; tput sgr0
    case $m_choice in
        1) get_editor; do_checkout; do_checkin ;; 2) do_revert ;; 3) do_previous ;; 4) do_compare ;; 5) do_view ;;
        6) rm -f ~/.vcoeditor; get_editor ;; 7) do_move ;; 8) do_rename ;; 9) do_delete ;; 10) exit 0 ;;
        *) echo "Invalid."; sleep $TTNS ;;
    esac
done
